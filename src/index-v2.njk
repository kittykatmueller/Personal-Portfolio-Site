<style>
  /* ── V2 Hero ── */
  .v2-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    padding: 4rem 2rem 3rem;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    max-width: 1200px;
    margin: 0 auto;
  }

  .v2-hero-left {
    opacity: 0;
    animation: v2FadeUp 0.55s ease 0.15s forwards;
  }

  .v2-hero-right {
    opacity: 0;
    animation: v2FadeUp 0.55s ease 0.25s forwards;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 6px;
  }

  .v2-tag {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent, #e8544a);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .v2-name {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .v2-bio {
    font-size: 13px;
    line-height: 1.75;
    opacity: 0.6;
    max-width: 420px;
  }

  .v2-hero-cta-group {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .v2-cta-primary {
    background: var(--color-accent, #e8544a);
    color: white;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 22px;
    border-radius: 40px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .v2-cta-primary:hover { opacity: 0.85; }

  .v2-cta-link {
    font-size: 13px;
    opacity: 0.5;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }
  .v2-cta-link:hover { opacity: 0.8; }

  .v2-stat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    transition: border-color 0.2s;
  }
  .v2-stat:hover { border-color: rgba(255,255,255,0.15); }

  .v2-stat-label {
    font-size: 11px;
    opacity: 0.45;
  }

  .v2-stat-val {
    font-size: 12px;
    font-weight: 500;
  }

  .v2-stat-val--open { color: #5dcaa5; }

  /* ── V2 Projects ── */
  .v2-work-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 2rem;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    max-width: 1200px;
    margin: 0 auto;
    opacity: 0;
    animation: v2FadeUp 0.5s ease 0.35s forwards;
  }

  .v2-work-eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.4;
  }

  .v2-projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1200px;
    margin: 0 auto;
    opacity: 0;
    animation: v2FadeUp 0.6s ease 0.45s forwards;
  }

  .v2-proj {
    position: relative;
    overflow: hidden;
    padding: 2rem;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-decoration: none;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    border-right: 0.5px solid rgba(255,255,255,0.08);
  }

  .v2-proj:nth-child(2n) { border-right: none; }
  .v2-proj:nth-last-child(-n+2) { border-bottom: none; }

  /* Background image — always visible */
  .v2-proj-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center top;
    opacity: 0.18;
    transition: opacity 0.5s ease, transform 0.5s ease;
    transform: scale(1.0);
  }
  .v2-proj:hover .v2-proj-img {
    opacity: 0.3;
    transform: scale(1.04);
  }

  /* Gradient — always present */
  .v2-proj-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13,15,20,0.97) 40%, rgba(13,15,20,0.6) 75%, rgba(13,15,20,0.25) 100%);
    z-index: 1;
  }

  /* Coral top bar — slides in on hover */
  .v2-proj-accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--color-accent, #e8544a);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
    z-index: 3;
  }
  .v2-proj:hover .v2-proj-accent { transform: scaleX(1); }

  .v2-proj-content {
    position: relative;
    z-index: 2;
  }

  .v2-proj-index {
    font-size: 10px;
    opacity: 0.4;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .v2-proj-nda {
    font-size: 10px;
    opacity: 0.5;
    padding: 2px 8px;
    border: 0.5px solid rgba(255,255,255,0.15);
    border-radius: 20px;
  }

  .v2-proj-company {
    font-size: 11px;
    color: var(--color-accent, #e8544a);
    font-weight: 500;
    margin-bottom: 4px;
    opacity: 0.85;
  }

  .v2-proj-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 6px;
    transition: opacity 0.2s;
  }

  .v2-proj-desc {
    font-size: 12px;
    opacity: 0.5;
    line-height: 1.6;
    margin-bottom: 12px;
    max-width: 340px;
  }

  .v2-proj-tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
  }

  .v2-proj-tag {
    font-size: 10px;
    opacity: 0.45;
    padding: 2px 9px;
    border: 0.5px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .v2-proj:hover .v2-proj-tag {
    opacity: 0.7;
    border-color: rgba(255,255,255,0.2);
  }

  .v2-proj-arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 3;
    font-size: 15px;
    color: var(--color-accent, #e8544a);
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity 0.2s ease 0.05s, transform 0.2s ease 0.05s;
  }
  .v2-proj:hover .v2-proj-arrow { opacity: 1; transform: translateX(0); }

  @keyframes v2FadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .v2-hero {
      grid-template-columns: 1fr;
      padding: 2.5rem 1.25rem 2rem;
    }
    .v2-hero-right { display: none; }
    .v2-projects { grid-template-columns: 1fr; }
    .v2-proj:nth-child(2n) { border-right: none; }
    .v2-proj { border-right: none !important; min-height: 220px; }
    .v2-proj:last-child { border-bottom: none; }
  }
</style>

